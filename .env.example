# Connection string Postgres. Local: docker compose; Production: Neon (nhớ có ?sslmode=require)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Khoá bí mật để ký JWT. Production phải là chuỗi random dài, KHÔNG dùng lại giá trị dev
JWT_SECRET="thay-bang-chuoi-random-that-dai"

# Thời hạn access token: 30d, 12h, 60m... Không khai báo thì mặc định 30 ngày
JWT_EXPIRES_IN="30d"

# Các origin frontend được phép gọi API, cách nhau bởi dấu phẩy
CORS_ORIGINS="http://localhost:3001"

# Render tự set biến này, local không cần khai báo
# PORT=3000
